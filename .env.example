# 默认离线演示，启动不会调用付费模型或下载权重。
RUNTIME_MODE=demo
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/local/app.db
LOCAL_VECTOR_PATH=data/local/vectors.json
KNOWLEDGE_DIR=knowledge
SEED_DEMO=true
LOG_LEVEL=INFO
MCP_ENABLED=false
MCP_REMOTE_URL=
REDIS_URL=
QDRANT_URL=
# 模型模式：显式设置 RUNTIME_MODE=model；本轮尚未使用真实 API 验证。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
# 可替换成已下载模型的本地绝对路径；默认只加载本地/缓存，不下载。
MODEL_DOWNLOAD_ALLOWED=false
# 可选 OpenAI-compatible embedding API
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-small-zh-v1.5
# Markdown 无需 Unstructured；PDF/Office 解析须安装 docs 额外依赖。
UNSTRUCTURED_ENABLED=false
MAX_RETRIEVAL_HOPS=3
RETRIEVAL_TOP_K_SIMPLE=5
RETRIEVAL_TOP_K_COMPLEX=8
RERANK_TOP_N=5
ADMIN_API_TOKEN=
